-- Появление через вентиляцию. Всё в этом файле можно менять.

return {
	BlackScreenTime = 1.4, -- сколько секунд темнота и звуки канализации перед вылетом
	PushSpeed = 60, -- с какой скоростью труба тащит тело к люку
	KickForward = 36, -- насколько сильно выплёвывает из люка вперёд
	KickUp = 16, -- и вверх
	KickSpin = 9, -- насколько сильно крутит тело в полёте
	LaunchInterval = 0.35, -- пауза между игроками, когда вылетают толпой

	MinLyingTime = 0.9, -- сколько минимум лежим после вылета
	MaxLyingTime = 4, -- через сколько секунд после вылета встаём в любом случае

	CinematicCamera = true, -- камера смотрит на люк со стороны; false = обычная камера
	ShowArrivalMessage = true, -- писать в чат "игрок выпал из вентиляции" при входе на сервер
}
