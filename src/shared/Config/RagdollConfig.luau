-- Рэгдолл (тело-тряпка как в Garry's Mod). Всё в этом файле можно менять.

return {
	ManualKey = Enum.KeyCode.R, -- клавиша, чтобы упасть самому
	ManualOnlyInLobby = true, -- падать по кнопке можно только в лобби
	ManualCooldown = 1.5, -- задержка между нажатиями
	ManualMinTime = 1, -- сколько минимум лежим, прежде чем можно встать
	ManualMaxTime = 8, -- через сколько секунд встаём сами
	TripSpeed = 14, -- с какой силой спотыкаемся вперёд при падении на бегу

	RagdollOnDeath = true, -- после смерти тело падает тряпкой, а не разваливается

	ImpactSoftSpeed = 14, -- с какой скорости удар считается ударом (тихий звук)
	ImpactHardSpeed = 45, -- с какой скорости удар считается сильным
	ImpactBreakSpeed = 90, -- с какой скорости играет хруст (если в SoundConfig есть звуки BodyBreak)
}
